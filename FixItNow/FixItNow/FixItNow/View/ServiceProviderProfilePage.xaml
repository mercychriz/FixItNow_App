<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FixItNow.View.ServiceProviderProfilePage"
             BackgroundColor="White">

    <ScrollView>
        <StackLayout Padding="20" Spacing="15">

            <Label Text="Create Service Provider Profile"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   TextColor="Black"/>

            <!-- Profile Picture -->
            <Frame HasShadow="True" CornerRadius="50" Padding="5" BackgroundColor="LightGray" HorizontalOptions="Center">
                <Image HeightRequest="100" WidthRequest="100" Aspect="AspectFill" Source="{Binding ProfileImage}" />
            </Frame>
            <Button Text="Upload Profile Picture"
                    BackgroundColor="#007AFF"
                    TextColor="White"
                    Command="{Binding UploadProfileImageCommand}"/>

            <!-- ID Card -->
            <Frame HasShadow="True" CornerRadius="10" Padding="5" BackgroundColor="LightGray" HorizontalOptions="Center">
                <Image HeightRequest="100" WidthRequest="150" Aspect="AspectFit" Source="{Binding IdCardImage}" />
            </Frame>
            <Button Text="Upload ID Card"
                    BackgroundColor="#007AFF"
                    TextColor="White"
                    Command="{Binding UploadIdCardImageCommand}"/>

            <!-- Form Fields -->
            <Entry Placeholder="Business Name" Text="{Binding BusinessName}" />
            <Entry Placeholder="Services Offered" Text="{Binding ServicesOffered}" />
            <Entry Placeholder="Location" Text="{Binding Location}" />
            <Entry Placeholder="Price" Keyboard="Numeric" Text="{Binding Price}" />
            <Entry Placeholder="Phone Number" Keyboard="Telephone" Text="{Binding PhoneNumber}" />
            <Entry Placeholder="Full Name" Text="{Binding FullName}" />
            <Editor Placeholder="Bio" HeightRequest="100" Text="{Binding Bio}" />

            <!-- Save Button -->
            <Button Text="Save Profile"
                    BackgroundColor="Green"
                    TextColor="White"
                    FontAttributes="Bold"
                    Command="{Binding SaveProfileCommand}"/>

        </StackLayout>
    </ScrollView>
</ContentPage>
