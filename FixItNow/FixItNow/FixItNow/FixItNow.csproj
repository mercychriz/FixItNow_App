      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="View\BookingPage.xaml">
      <Generator>MSBuild:UpdateDesignTimeXaml</Generator>
