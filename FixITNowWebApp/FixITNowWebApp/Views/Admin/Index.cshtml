@model List<FixITNowWebApp.DTOs.ServiceDto>
@{
    ViewBag.Title = "Admin Dashboard";
}

<h2 style="text-align:center;">Admin Dashboard</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div style="padding: 20px; background-color: #f4f4f4;">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Service Name</th>
                <th>Description</th>
                <th>Price</th>
                <th style="width: 200px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var service in Model)
            {
                <tr>
                    <td>@service.ServiceName</td>
                    <td>@service.ServiceDescription</td>
                    <td>@service.Price</td>
                    <td>
                        @* Replace with modal or full view if needed *@
                        <a href="@Url.Action("Edit", "Admin", new { id = service.ServiceProviderId })" class="btn btn-warning btn-sm">Edit</a>
                        @using (Html.BeginForm("Delete", "Admin", FormMethod.Post))
                        {
                            @Html.Hidden("id", service.ServiceProviderId)
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-3">
        <a href="@Url.Action("Add", "Admin")" class="btn btn-primary">Add New Service</a>
        <a href="@Url.Action("DownloadCsv")" class="btn btn-secondary">Download CSV Report</a>
        <a href="@Url.Action("Logout")" class="btn btn-warning">Log Out</a>
    </div>
</div>
