@model FixITNowWebApp.DTOs.ServiceDto

@{
    ViewBag.Title = "Edit Service";
    Layout = "~/Views/Shared/_Layout.cshtml"; // optional
}

<h2>Edit Service</h2>

@using (Html.BeginForm("Edit", "Admin", FormMethod.Post))
{
    @* ✅ Ensure hidden fields are passed correctly *@
    @Html.HiddenFor(m => m.ServiceId)
    @Html.Hidden("ServiceProviderId", Model.ServiceProviderId) <!-- DO NOT use HiddenFor here -->

    <div class="form-group">
        @Html.LabelFor(m => m.ServiceName)
        @Html.TextBoxFor(m => m.ServiceName, new { @class = "form-control", placeholder = "Enter Service Name" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.ServiceDescription)
        @Html.TextAreaFor(m => m.ServiceDescription, new { @class = "form-control", placeholder = "Enter Description", rows = 3 })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Price)
        @Html.TextBoxFor(m => m.Price, new { @class = "form-control", type = "number", step = "0.01", placeholder = "Enter Price" })
    </div>

    <button type="submit" class="btn btn-primary">Update Service</button>
    <a href="@Url.Action("Index", "Admin")" class="btn btn-secondary">Cancel</a>
}
